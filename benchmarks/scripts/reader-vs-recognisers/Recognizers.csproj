<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft Recognizers-Text, the maintained .NET release, behind a line-per-request helper for compare.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="[1.8.13]" />
    <PackageReference Include="Microsoft.Recognizers.Text.Number" Version="[1.8.13]" />
  </ItemGroup>
</Project>
